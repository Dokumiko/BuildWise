# Only product runtime source, setup files, and the bootstrap dataset belong in Git.
# Local documentation, research, quality checks, and collection tooling remain on
# the operator machine and must not be staged accidentally.
/docs/
/backend/docs/
/backend/tests/

# Offline thesis/search-evaluation utilities are not part of the shipped app.
/backend/src/app/scripts/run_search_evaluation.py
/backend/src/app/services/evaluation.py
/backend/src/app/services/persisted_evaluation.py
/tools/
/outputs/
/work/
/AGENTS.md
/PRODUCT.md

# Retain exactly the DDL baseline and the catalog imported by backend/README.md.
/backend/data/*
!/backend/data/database-schema-v0.1.sql
!/backend/data/vn-pc-am5-ddr5-v0.2-catalog-evaluation-intake.json

# Python environments, caches, and coverage output.
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Environment-specific configuration and Windows accidental files.
.env
.env.*
!.env.example
nul
NUL

# Node / Next.js build and package-manager output.
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor, OS, and local agent state.
.vscode/
.idea/
.DS_Store
Thumbs.db
.agents/
.claude/
.codex/
.impeccable/
skills-lock.json

# Local extracted Python dependencies; install from backend package metadata instead.
.deps/
